# Copy to .env and fill in. Environment variables always take precedence.

# --- Groq (config/experiment_groq.yaml) - free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Anthropic (Claude) - or run `ant auth login` instead of setting a key
ANTHROPIC_API_KEY=

# --- Oracle connection (config/experiment_oracle.yaml)
ORACLE_USER=sqlrw
ORACLE_PASSWORD=sqlrw
ORACLE_DSN=localhost:1521/FREEPDB1

# --- docker-compose SYS password for the local Oracle Free container
ORACLE_SYS_PASSWORD=OracleSys123
